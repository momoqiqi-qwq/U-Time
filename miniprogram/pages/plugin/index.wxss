.plugin-head { display: flex; align-items: center; gap: 20rpx; }
.icon { width: 84rpx; height: 84rpx; border-radius: 20rpx; background: var(--paper); border: 2rpx solid var(--line); display: flex; align-items: center; justify-content: center; color: var(--deep); font-size: 38rpx; font-weight: 800; }
.head-copy { min-width: 0; }
.title { font-size: 34rpx; font-weight: 750; }
.meta { color: var(--ink-3); font-size: 21rpx; margin-top: 6rpx; line-height: 1.5; }
.section-title { font-size: 28rpx; font-weight: 700; margin-bottom: 18rpx; }
.hint { margin-top: 22rpx; padding-top: 18rpx; border-top: 1rpx dashed var(--line); }

.pomo-card { text-align: center; }
.modes { display: flex; justify-content: center; gap: 10rpx; flex-wrap: wrap; }
.mode { margin: 0; min-height: 58rpx; line-height: 58rpx; padding: 0 20rpx; font-size: 22rpx; color: var(--ink-2); background: var(--paper); border: 1rpx solid var(--line); border-radius: 999rpx; }
.mode::after { border: none; }
.mode.on { background: var(--deep); color: var(--on-deep); border-color: var(--deep); }
.clock { font-size: 92rpx; font-weight: 300; font-variant-numeric: tabular-nums; letter-spacing: .04em; margin: 44rpx 0 36rpx; }
.label { font-size: 22rpx; color: var(--ink-2); margin-bottom: 10rpx; }
.pickerbox { max-width: 520rpx; margin: 0 auto; min-height: 76rpx; line-height: 76rpx; background: var(--paper); border: 2rpx solid var(--line); border-radius: 14rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding: 0 18rpx; box-sizing: border-box; }
.controls { display: flex; justify-content: center; gap: 14rpx; margin-top: 24rpx; }
.pomo-stats { margin-top: 26rpx; color: var(--ink-2); font-size: 23rpx; }
.pomo-stats text { color: var(--deep); font-weight: 700; }

.day { margin-bottom: 16rpx; }
.daytop { display: flex; justify-content: space-between; gap: 20rpx; font-size: 22rpx; color: var(--ink-2); }
.bartrack { height: 16rpx; border-radius: 999rpx; background: var(--paper); overflow: hidden; margin-top: 8rpx; }
.bar { height: 100%; min-width: 6rpx; border-radius: 999rpx; background: var(--sea); }
.summary { margin-top: 22rpx; padding-top: 18rpx; border-top: 1rpx dashed var(--line); color: var(--ink-2); line-height: 1.7; font-size: 23rpx; }
.summary .strong { color: var(--ink); font-weight: 700; }
.catrow { display: flex; align-items: center; gap: 12rpx; padding: 12rpx 0; }
.catdot { width: 18rpx; height: 18rpx; border-radius: 6rpx; flex: none; }
.catname { flex: 1; font-size: 24rpx; }
.catvalue { color: var(--ink-2); font-variant-numeric: tabular-nums; }
.catdot.cat-work { background: var(--deep); }.catdot.cat-study { background: var(--grape); }.catdot.cat-sport { background: var(--coral); }.catdot.cat-life { background: var(--sun); }.catdot.cat-rest { background: var(--mint); }

.hero-status { font-size: 42rpx; font-weight: 750; color: var(--deep); margin: 12rpx 0 4rpx; }
.holiday-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 20rpx 0; border-bottom: 1rpx solid var(--line-soft); }
.holiday-row:last-of-type { border-bottom: none; }
.holiday-name { font-size: 26rpx; font-weight: 650; }
.countdown { color: var(--deep); font-size: 23rpx; font-weight: 700; white-space: nowrap; }

/* 考试日历：日期列固定宽 + 名称/元信息两行 + 右侧倒计时，与桌面端插件同构 */
.exam { padding: 20rpx 0; border-bottom: 1rpx solid var(--line-soft); }
.exam:last-child { border-bottom: none; }
.exam.est { opacity: .72; }
.exam.hot { border-left: 6rpx solid var(--coral); padding-left: 16rpx; }
.exam-head { display: flex; align-items: flex-start; gap: 14rpx; }
.exam-dcol { flex: none; width: 168rpx; }
.exam-d1 { font-size: 24rpx; font-weight: 700; white-space: nowrap; }
.exam-d2 { font-size: 20rpx; color: var(--ink-3); margin-top: 4rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.exam-bcol { flex: 1; min-width: 0; }
.exam-l1 { display: flex; align-items: center; gap: 8rpx; }
.exam-dot { flex: none; width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--mint); }
.exam-dot.est { background: transparent; border: 2rpx solid var(--ink-3); box-sizing: border-box; }
.exam-title { flex: 1; min-width: 0; font-size: 26rpx; font-weight: 680; line-height: 1.4; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.exam-tag { flex: none; font-size: 19rpx; padding: 2rpx 8rpx; border-radius: 6rpx; background: var(--paper); color: var(--ink-2); }
.exam-l2 { font-size: 20rpx; color: var(--ink-3); margin-top: 6rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.exam-cd { flex: none; font-size: 20rpx; color: var(--ink-3); white-space: nowrap; padding-top: 4rpx; }
.exam-cd.urgent { color: var(--coral); font-weight: 700; }
.exam-cd.soon { color: var(--sun); font-weight: 700; }
.exam-cd.near { color: var(--ink); }
.exam-cd.live { color: var(--sea); font-weight: 700; }
.exam-actions { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 14rpx; }
.exam-actions .btn { margin: 0; }
.exam-done { font-size: 22rpx; color: var(--mint); border: 1rpx solid var(--mint); border-radius: 10rpx; padding: 0 16rpx; line-height: 60rpx; }

.exam-tools { display: flex; gap: 14rpx; align-items: center; margin-top: 18rpx; }
.exam-search { flex: 1; min-width: 0; height: 72rpx; border: 1rpx solid var(--line); border-radius: 14rpx; padding: 0 18rpx; background: var(--paper); font-size: 23rpx; box-sizing: border-box; }
.exam-chip { flex: none; font-size: 22rpx; height: 72rpx; line-height: 70rpx; padding: 0 22rpx; border-radius: 999rpx; border: 1rpx solid var(--line); color: var(--ink-2); box-sizing: border-box; }
.exam-chip.on { background: var(--deep); border-color: var(--deep); color: var(--on-deep); }

.exam-hist-toggle { display: flex; align-items: center; justify-content: space-between; font-size: 24rpx; color: var(--ink-2); padding: 6rpx 0; }
.exam-hist-arrow { font-size: 18rpx; color: var(--ink-3); }
.exam-hist-year { font-size: 21rpx; color: var(--ink-3); margin: 18rpx 0 8rpx; }
.exam-hist-line { display: flex; gap: 14rpx; font-size: 21rpx; color: var(--ink-3); padding: 6rpx 0; border-bottom: 1rpx solid var(--line-soft); }
.exam-hist-date { flex: none; width: 190rpx; color: var(--ink-2); }
.exam-hist-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.fa-icon { width: 46rpx; height: 46rpx; display: block; }
.custom-row{display:flex;gap:16rpx;align-items:center;margin:18rpx 0}.custom-row input{flex:1;min-width:0;height:72rpx;border:1px solid #e4dfd6;border-radius:14rpx;padding:0 18rpx;background:#fff}.custom-row .btn{margin:0;white-space:nowrap}
/* 番茄自定义时长：分 / 秒两个窄输入框 + 单位，别让它们按 flex:1 平摊掉整行。 */
.pomo-custom input{flex:0 0 118rpx;text-align:center;padding:0 8rpx}
.pomo-custom .unit{font-size:24rpx;color:#8fa2a8}

.exam-notice { margin-top: 18rpx; padding: 16rpx 18rpx; border-left: 6rpx solid var(--deep); background: var(--paper); border-radius: 8rpx; color: var(--ink-2); font-size: 22rpx; line-height: 1.75; }
.exam-signup { margin: 18rpx 0 0; }

/* ════ 插件使用说明 ════ */
.guide-actions { display: flex; gap: 14rpx; margin-top: 18rpx; }
.guide-card { border: 2rpx solid var(--line); border-radius: 16rpx; padding: 20rpx; margin-bottom: 16rpx; background: var(--paper); }
.guide-card:last-child { margin-bottom: 0; }
.guide-card.off { opacity: .78; }
.guide-top { display: flex; gap: 14rpx; align-items: center; }
.guide-icon { width: 60rpx; height: 60rpx; border-radius: 14rpx; flex: none; }
.guide-copy { min-width: 0; flex: 1; }
.guide-name { font-size: 27rpx; font-weight: 700; }
.guide-native { margin-left: 10rpx; font-size: 18rpx; color: var(--on-deep); background: var(--deep); border-radius: 999rpx; padding: 2rpx 12rpx; vertical-align: 4rpx; }
.guide-desc { font-size: 22rpx; color: var(--ink-2); line-height: 1.7; margin: 12rpx 0 4rpx; }
.guide-step { font-size: 22rpx; color: var(--ink-2); line-height: 1.9; }

/* ════ 轮换值日 ════
   一个插件里可以有多套轮换（宿舍值日 / 公区卫生…），各有各的成员与周期。
   窄屏一律竖排（名字行 / 区间 / 倒计时三行），不做桌面端那种三列网格 ——
   桌面端踩过「grid 自动排布被 grid-column:1/-1 打乱、标签被撑成整行横幅」的坑，
   手机上直接不给自己留这个机会。 */
.dd-alert { border-left: 8rpx solid var(--sun); background: rgba(214, 158, 46, .1); }
.dd-alert-t { font-size: 28rpx; font-weight: 700; color: var(--deep); line-height: 1.5; }
.dd-who { display: flex; align-items: center; gap: 16rpx; flex-wrap: wrap; margin: 8rpx 0 4rpx; }
.dd-big { font-size: 56rpx; font-weight: 800; letter-spacing: .01em; }
/* 多人当班时名字串很长，56rpx 会把卡片撑成三行 —— 略缩一号 */
.dd-big-multi { font-size: 38rpx; line-height: 1.4; }
.dd-badge { font-size: 20rpx; font-weight: 700; border-radius: 999rpx; padding: 4rpx 16rpx; background: rgba(214, 158, 46, .18); color: var(--sun); }
.dd-next { display: flex; align-items: baseline; gap: 8rpx; margin: 8rpx 0 4rpx; }
.dd-next-u { font-size: 26rpx; font-weight: 650; color: var(--deep); }
.dd-actions { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; }
.dd-actions .btn { margin: 0; }

.dd-row { padding: 18rpx 0; }
.dd-row + .dd-row { border-top: 1rpx solid var(--line-soft); }
.dd-row-top { display: flex; align-items: center; gap: 12rpx; }
.dd-name { font-size: 27rpx; font-weight: 680; }
.dd-tag { flex: none; font-size: 18rpx; border-radius: 999rpx; padding: 2rpx 12rpx; background: rgba(214, 158, 46, .18); color: var(--sun); }
.dd-range { display: block; font-size: 22rpx; color: var(--ink-2); margin-top: 6rpx; }
.dd-days { display: block; font-size: 21rpx; color: var(--ink-3); margin-top: 4rpx; }

.dd-mrow { display: flex; align-items: center; gap: 12rpx; padding: 14rpx 0; }
.dd-mrow + .dd-mrow { border-top: 1rpx solid var(--line-soft); }
.dd-mno { flex: none; width: 40rpx; font-size: 21rpx; color: var(--ink-3); text-align: center; font-variant-numeric: tabular-nums; }
.dd-drag { flex: none; width: 46rpx; min-height: 56rpx; display: flex; align-items: center; justify-content: center; color: var(--ink-3); font-size: 28rpx; line-height: 1; touch-action: none; }
.dd-drag.on { color: var(--deep); background: rgba(15, 76, 92, .08); border-radius: 12rpx; }
.dd-mname { flex: 1; min-width: 0; display: flex; align-items: center; gap: 10rpx; font-size: 26rpx; font-weight: 600; }
.dd-cur { flex: none; font-size: 18rpx; border-radius: 999rpx; padding: 2rpx 12rpx; background: var(--deep); color: var(--on-deep); }
.dd-mbtns { flex: none; display: flex; gap: 8rpx; }
.dd-mbtns .btn { margin: 0; padding: 0 16rpx; min-height: 56rpx; line-height: 56rpx; font-size: 22rpx; }
.btn.dd-mini.danger { color: var(--coral); border-color: rgba(176, 53, 53, .4); }

.dd-add { display: flex; gap: 12rpx; align-items: center; margin-top: 18rpx; }
.dd-in { flex: 1; min-width: 0; height: 72rpx; border: 1rpx solid var(--line); border-radius: 14rpx; padding: 0 18rpx; background: var(--paper); font-size: 23rpx; box-sizing: border-box; }
.dd-addbtn { flex: none; margin: 0; }
.dd-removed { margin-top: 20rpx; border-top: 1rpx dashed var(--line); padding-top: 14rpx; }
.dd-chips { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 10rpx; }
.dd-chip { font-size: 22rpx; border: 2rpx solid var(--line); background: var(--paper); border-radius: 999rpx; padding: 8rpx 22rpx; color: var(--ink-2); }
.dd-chip.on { background: var(--deep); color: var(--on-deep); border-color: var(--deep); }

/* 多套轮换的切换条。选中态是深底浅字，当班人跟着走 opacity —— 别给固定色，
   否则深底上会看不清。
   ⚠️ 组名与当班人之间用 margin 而不是空格：<text> 里元素边界处的空白在渲染时可能被吞，
   桌面端那边是靠 flex 的 gap 撑开的，这里得自己给。 */
.dd-gchips { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 10rpx; }
.dd-gtab { display: flex; align-items: stretch; }
.dd-gchip { font-size: 23rpx; border: 2rpx solid var(--line); background: var(--paper); border-radius: 999rpx; padding: 8rpx 22rpx; color: var(--ink-2); }
.dd-gchip.on { background: var(--deep); color: var(--on-deep); border-color: var(--deep); font-weight: 700; }
.dd-gwho { font-size: 20rpx; opacity: .75; margin-left: 8rpx; }
/* 「⋯」= 桌面端右键菜单的触屏入口，贴在标签右端做成同一颗药丸的尾巴，
   和标签分开绑 tap，才不会点菜单时顺手把当前轮换切走。 */
.dd-gmore { display: flex; align-items: center; padding: 0 16rpx; margin-left: 6rpx; border: 2rpx solid var(--line); border-radius: 999rpx; background: var(--paper); color: var(--ink-2); font-size: 26rpx; line-height: 1; }

.dd-field { display: flex; align-items: center; gap: 16rpx; padding: 14rpx 0; }
.dd-field + .dd-field { border-top: 1rpx solid var(--line-soft); }
.dd-field .label { flex: none; width: 150rpx; margin: 0; font-size: 23rpx; color: var(--ink-2); }
.dd-field .dd-in { flex: 1; }
.dd-field .dd-chips { flex: 1; margin-top: 0; }
.dd-pick { height: 72rpx; line-height: 72rpx; border: 1rpx solid var(--line); border-radius: 14rpx; padding: 0 18rpx; background: var(--paper); font-size: 23rpx; color: var(--ink); min-width: 240rpx; box-sizing: border-box; }

/* ════ 微信提醒推送 ════ */
.push-docs { margin: 12rpx 0; }
.push-link { font-size: 22rpx; color: var(--sea); padding: 4rpx 0; }
.push-provider { display: flex; gap: 12rpx; margin: 16rpx 0; }
.push-pro { flex: 1; text-align: center; font-size: 23rpx; padding: 16rpx 0; border: 2rpx solid var(--line); border-radius: 12rpx; color: var(--ink-2); background: var(--paper); }
.push-pro.on { border-color: var(--deep); color: var(--deep); font-weight: 650; box-shadow: inset 0 0 0 2rpx var(--deep); }
.push-field { margin-top: 16rpx; }
.push-field .label { font-size: 21rpx; color: var(--ink-2); margin-bottom: 8rpx; }
.push-field input { height: 74rpx; border: 2rpx solid var(--line); border-radius: 12rpx; padding: 0 18rpx; background: var(--paper); font-size: 23rpx; box-sizing: border-box; }
.push-btn { margin-top: 12rpx; }
.push-switches { margin: 20rpx 0 6rpx; }
.push-switch { display: flex; align-items: center; gap: 12rpx; padding: 8rpx 0; font-size: 23rpx; color: var(--ink-2); }
.push-log { margin-top: 24rpx; border-top: 2rpx dashed var(--line); padding-top: 16rpx; }
.push-logline { font-size: 20rpx; color: var(--ink-2); padding: 4rpx 0; word-break: break-all; }
.push-logline.bad { color: var(--coral); }
.flex-none { flex: none; }

/* ════ 竞赛消息雷达 ════ */
.gx-toolbar { display: flex; gap: 14rpx; align-items: center; margin-bottom: 16rpx; }
.gx-refresh { flex: none; margin: 0; }
.gx-kw { flex: 1; min-width: 0; height: 72rpx; border: 2rpx solid var(--line); border-radius: 14rpx; padding: 0 18rpx; background: var(--paper); font-size: 23rpx; box-sizing: border-box; }
.gx-chips { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 14rpx; }
.gx-chip { font-size: 22rpx; border: 2rpx solid var(--line); background: var(--paper); border-radius: 999rpx; padding: 8rpx 22rpx; color: var(--ink-2); }
.gx-chip.on { background: var(--deep); color: var(--on-deep); border-color: var(--deep); }
.gx-status { font-size: 22rpx; color: var(--ink-2); margin: 4rpx 0 14rpx; }
.gx-status.err { color: var(--coral); }
.gx-month { font-size: 24rpx; font-weight: 700; color: var(--deep); padding: 12rpx 2rpx 8rpx; }
.gx-card { display: flex; gap: 14rpx; background: var(--paper); border: 2rpx solid var(--line); border-radius: 16rpx; padding: 18rpx 20rpx; margin-bottom: 12rpx; align-items: flex-start; }
.gx-card.seen { opacity: .55; }
.gx-main { flex: 1; min-width: 0; }
.gx-title { font-size: 26rpx; font-weight: 650; line-height: 1.5; }
.gx-new { margin-left: 10rpx; background: var(--coral); color: #fff; border-radius: 8rpx; padding: 1rpx 10rpx; font-size: 18rpx; }
.gx-meta { display: flex; gap: 14rpx; align-items: center; font-size: 20rpx; color: var(--ink-2); margin-top: 6rpx; flex-wrap: wrap; }
.gx-tag { border-radius: 8rpx; padding: 2rpx 12rpx; background: rgba(15, 76, 92, .12); color: var(--deep); font-size: 18rpx; }
.gx-tag.hot { background: rgba(108, 63, 184, .12); color: var(--grape); }
.gx-snip { font-size: 21rpx; color: var(--ink-2); margin-top: 8rpx; line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.gx-remind { flex: none; margin: 0; }
.gx-more { margin-top: 8rpx; }
.empty { border: 3rpx dashed var(--line); border-radius: 14rpx; padding: 30rpx; text-align: center; color: var(--ink-3); font-size: 23rpx; line-height: 1.8; margin: 10rpx 0; }

/* ════ 学习通 ════ */
.cx-login-tabs { justify-content: flex-start; margin-bottom: 20rpx; }
.cx-nav { justify-content: flex-start; margin: 20rpx 0 14rpx; }
.cx-actions { display: flex; flex-wrap: wrap; gap: 12rpx; }
.cx-actions .btn { margin: 0; }
.cx-wide { margin-top: 20rpx; }
.cx-textarea { width: 100%; min-height: 160rpx; border: 2rpx solid var(--line); border-radius: 12rpx; padding: 14rpx 18rpx; background: var(--paper); font-size: 22rpx; box-sizing: border-box; }
.cx-check { display: flex; align-items: center; gap: 12rpx; margin-top: 16rpx; font-size: 22rpx; color: var(--ink-2); }
.cx-unread-toggle { margin: 4rpx 0 12rpx; }
.cx-error { margin-top: 16rpx; padding: 14rpx 16rpx; border-radius: 10rpx; background: rgba(176, 53, 53, .1); border: 2rpx solid rgba(176, 53, 53, .32); color: var(--coral); font-size: 22rpx; line-height: 1.7; word-break: break-all; }
.cx-toolbar { display: flex; gap: 14rpx; align-items: center; margin-bottom: 6rpx; }
.cx-search { flex: 1; min-width: 0; height: 72rpx; border: 2rpx solid var(--line); border-radius: 14rpx; padding: 0 18rpx; background: var(--paper); font-size: 23rpx; box-sizing: border-box; }
.cx-cat { min-width: 160rpx; line-height: 72rpx; min-height: 72rpx; }
.cx-kpis { display: flex; gap: 12rpx; flex-wrap: wrap; margin: 14rpx 0; }
.cx-kpi { background: var(--paper); border: 2rpx solid var(--line); border-radius: 10rpx; padding: 8rpx 14rpx; font-size: 20rpx; color: var(--ink-2); }
.cx-card { background: var(--cx-read-bg, var(--paper)); border: 2rpx solid var(--line); border-left: 8rpx solid var(--line); border-radius: 14rpx; padding: 18rpx; margin-bottom: 14rpx; }
/* 分类强调色。class 一律用 ASCII（exam/work/checkin/notice）——
   WXSS 选择器不支持非 ASCII 标识符，写 `.cat-考试` 会让编译器把多字节字符切碎，
   上传时报 `unexpected \`�\` at pos ...` 直接拒绝整个包（v0.40.0 实测）。
   中文只作为文本内容出现在 WXML 里，不参与选择器。 */
.cx-card.cat-exam { border-left-color: var(--coral); }
.cx-card.cat-work { border-left-color: var(--sun); }
.cx-card.cat-checkin { border-left-color: var(--mint); }
.cx-card.cat-notice { border-left-color: var(--deep); }
/* 未读/已读背景差：未读 = 海青染色 + 三边海青描边（左边框保持类型色，不能写 border-color 简写）；
   已读 = 往 --ink 灰化。变量按深浅模式各给一组（WXSS 无 color-mix，色值由桌面端同幅度换算）。
   page 级选择器在页面 wxss 里合法且只作用于本页，不污染其他页面。 */
page {
  --cx-read-bg: #ECEBE6;      /* paper 混 ink 5%（暖灰化） */
  --cx-unread-bg: #D5E5E8;    /* paper 混 sea 15% */
  --cx-unread-edge: #94BEC8;  /* line 混 sea 38% */
}
@media (prefers-color-scheme: dark) {
  page {
    --cx-read-bg: #252E34;
    --cx-unread-bg: #203945;
    --cx-unread-edge: #386C82;
  }
}
.cx-card.unread { background: var(--cx-unread-bg); border-top-color: var(--cx-unread-edge); border-right-color: var(--cx-unread-edge); border-bottom-color: var(--cx-unread-edge); }
.cx-card.open .cx-body { display: block; -webkit-line-clamp: unset; max-height: 640rpx; overflow: auto; }
.cx-title { font-size: 26rpx; font-weight: 650; line-height: 1.5; word-break: break-all; }
.cx-meta { display: flex; gap: 12rpx; flex-wrap: wrap; align-items: center; margin: 8rpx 0; font-size: 20rpx; color: var(--ink-2); }
.cx-tag { padding: 2rpx 12rpx; border-radius: 999rpx; background: rgba(15, 76, 92, .12); color: var(--deep); font-size: 19rpx; }
.cx-tag.work { background: rgba(214, 158, 46, .18); color: var(--sun); }
.cx-tag.exam { background: rgba(176, 53, 53, .14); color: var(--coral); }
.cx-tag.checkin { background: rgba(46, 196, 182, .18); color: var(--mint); }
.cx-pill { display: inline-block; margin-left: 8rpx; font-size: 18rpx; border-radius: 999rpx; padding: 2rpx 10rpx; background: var(--paper); color: var(--ink-2); border: 1rpx solid var(--line); vertical-align: 3rpx; }
.cx-pill.new { background: var(--coral); color: #fff; border-color: var(--coral); }
.cx-pill.grading { background: rgba(214, 158, 46, .18); color: var(--sun); border-color: rgba(214, 158, 46, .4); }
.cx-body { font-size: 22rpx; color: var(--ink-2); line-height: 1.7; white-space: pre-line; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; margin-top: 4rpx; word-break: break-all; }
.cx-due { font-size: 23rpx; font-weight: 700; color: var(--sun); margin: 6rpx 0; }
.cx-card-actions { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 14rpx; }
.cx-card-actions .btn { margin: 0; }
.btn.danger { color: var(--coral); border-color: rgba(176, 53, 53, .4); }
.cx-status-sec { margin: 20rpx 0 6rpx; }
.cx-grade-head { display: flex; align-items: baseline; gap: 10rpx; font-size: 25rpx; font-weight: 650; margin-bottom: 12rpx; }
.cx-dot { display: inline-block; width: 16rpx; height: 16rpx; border-radius: 50%; margin-right: 6rpx; }
.cx-dot.dot-red { background: #dc2626; } .cx-dot.dot-blue { background: #2563eb; } .cx-dot.dot-green { background: #16a34a; } .cx-dot.dot-gray { background: #9ca3af; }
.cx-course { border: 2rpx solid var(--line); border-radius: 12rpx; padding: 14rpx 16rpx; margin-bottom: 12rpx; background: var(--paper); }
.cx-course.st-red { background: rgba(176, 53, 53, .12); border-color: rgba(176, 53, 53, .32); }
.cx-course.st-blue { background: rgba(46, 196, 182, .1); border-color: rgba(46, 196, 182, .32); }
.cx-course.st-green { background: rgba(22, 163, 74, .08); border-color: rgba(22, 163, 74, .28); }
.cx-course-name { font-size: 24rpx; font-weight: 650; }
.cx-mark { float: right; font-size: 18rpx; font-weight: 500; border-radius: 999rpx; padding: 2rpx 12rpx; }
.cx-mark.st-red { background: #dc2626; color: #fff; } .cx-mark.st-blue { background: #2563eb; color: #fff; }
.cx-mark.st-green { background: #16a34a; color: #fff; } .cx-mark.st-gray { background: #9ca3af; color: #fff; }

/* ════ 拖入消息收纳（inbox-drop）════
   小程序端只用这一组 id-* 类；桌面端的 .id-* 是 DOM 插件样式，两者不共享。 */
.id-ta { width: 100%; box-sizing: border-box; min-height: 180rpx; padding: 20rpx; margin-top: 12rpx;
  border: 2rpx solid var(--line); border-radius: 14rpx; background: var(--paper); color: var(--ink);
  font-size: 25rpx; line-height: 1.6; }
.id-acts { display: flex; gap: 16rpx; margin-top: 16rpx; }
.id-acts .btn { flex: 1; margin: 0; }
.id-count { float: right; font-size: 21rpx; font-weight: 500; color: var(--ink-2); }
.id-empty { padding: 40rpx 0 24rpx; text-align: center; font-size: 26rpx; font-weight: 650; color: var(--ink-2); }
.id-row { border: 2rpx solid var(--line); border-radius: 14rpx; padding: 18rpx 20rpx; margin-top: 16rpx; background: var(--paper); }
.id-row.done { opacity: .62; }
.id-top { display: flex; align-items: baseline; gap: 10rpx; }
.id-seq { flex: none; font-size: 20rpx; font-weight: 700; color: var(--ink-3); }
.id-title { flex: 1; font-size: 26rpx; font-weight: 650; line-height: 1.5; word-break: break-all; }
.id-pin { flex: none; font-size: 18rpx; border-radius: 999rpx; padding: 2rpx 10rpx;
  background: rgba(214, 158, 46, .18); color: var(--sun); }
.id-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin: 10rpx 0 8rpx; }
.id-tag { font-size: 19rpx; border-radius: 999rpx; padding: 3rpx 12rpx;
  background: rgba(15, 76, 92, .12); color: var(--deep); }
.id-tag.ok { background: rgba(46, 196, 182, .18); color: var(--mint); }
.id-raw { font-size: 22rpx; color: var(--ink-2); line-height: 1.7; white-space: pre-line;
  max-height: 220rpx; overflow: hidden; word-break: break-all; padding-left: 20rpx;
  border-left: 4rpx solid var(--line-soft); }
.id-rowacts { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.id-rowacts .btn { margin: 0; }
.id-foot { display: flex; align-items: center; gap: 14rpx; margin-top: 20rpx; }
.id-foot .btn { flex: none; margin: 0; }
