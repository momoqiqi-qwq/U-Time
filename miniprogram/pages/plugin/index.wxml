<view class="page-body" wx:if="{{plugin}}">
  <view class="card plugin-head">
    <view class="icon"><image class="fa-icon" src="{{plugin.iconPath}}" mode="aspectFit" /></view>
    <view class="head-copy">
      <view class="title">{{plugin.name}}</view>
      <view class="meta">v{{plugin.version}} · 小程序原生适配</view>
    </view>
  </view>

  <!-- 番茄专注 -->
  <block wx:if="{{id === 'pomodoro' && pomodoro}}">
    <view class="card pomo-card">
      <view class="modes">
        <button class="mode {{item.active ? 'on' : ''}}" wx:for="{{pomodoro.modes}}" wx:key="id" data-id="{{item.id}}" bindtap="onPomoMode">{{item.label}}</button>
      </view>
      <view class="custom-row pomo-custom"><input type="number" value="{{pomodoro.customMinPart}}" bindinput="onPomoCustomMinInput" placeholder="分"/><text class="unit">分</text><input type="number" value="{{pomodoro.customSecPart}}" bindinput="onPomoCustomSecInput" placeholder="秒"/><text class="unit">秒</text><button class="btn ghost" bindtap="onPomoSetCustom">设置倒计时</button></view>
      <view class="clock">{{pomodoro.timeText}}</view>
      <view class="label">专注哪个任务（可选）</view>
      <picker mode="selector" range="{{pomodoro.tasks}}" range-key="title" value="{{pomodoro.taskIndex}}" bindchange="onPomoTask">
        <view class="pickerbox">{{pomodoro.tasks[pomodoro.taskIndex].title}}</view>
      </picker>
      <view class="custom-row"><input value="{{pomodoro.newTaskTitle}}" bindinput="onPomoNewTaskInput" placeholder="直接新建本次专注任务"/><button class="btn ghost" bindtap="onPomoAddTask">新建任务</button></view>
      <view class="controls">
        <button class="btn pri" bindtap="onPomoToggle">{{pomodoro.running ? '暂停' : '开始 / 继续'}}</button>
        <button class="btn ghost" bindtap="onPomoReset">重置</button>
      </view>
      <view class="pomo-stats">累计 <text>{{pomodoro.doneCount}}</text> 个番茄 · <text>{{pomodoro.focusMin}}</text> 分钟</view>
      <view class="desc hint">小程序退到后台时不会依赖持续计时器，而是记录结束时间；回到页面后按真实经过时间恢复。</view>
    </view>
  </block>

  <!-- 周度报告 -->
  <block wx:if="{{id === 'weekly-report' && weekly}}">
    <view class="card">
      <view class="section-title">过去 7 天</view>
      <view class="day" wx:for="{{weekly.days}}" wx:key="date">
        <view class="daytop"><text>{{item.weekday}} · {{item.date}}</text><text>{{item.label}}</text></view>
        <view class="bartrack"><view class="bar" style="width: {{item.pct}}%;"></view></view>
      </view>
      <view class="summary">排程合计 <text class="strong">{{weekly.totalLabel}}</text> · 日均 <text class="strong">{{weekly.averageLabel}}</text> · 任务完成 <text class="strong">{{weekly.done}}/{{weekly.taskCount}}</text></view>
    </view>
    <view class="card">
      <view class="section-title">分类占比</view>
      <view class="catrow" wx:for="{{weekly.cats}}" wx:key="id">
        <view class="catdot cat-{{item.id}}"></view><text class="catname">{{item.label}}</text><text class="catvalue">{{item.value}}</text>
      </view>
    </view>
  </block>

  <!-- 中国节假日 -->
  <block wx:if="{{id === 'cn-holiday' && holiday}}">
    <view class="card">
      <view class="section-title">今天 · {{holiday.today}}</view>
      <view class="hero-status">{{holiday.todayText}}</view>
      <view class="desc" wx:if="{{!holiday.available}}">当前包里没有 {{holiday.year}} 年离线数据，可在桌面 / Android 插件联网更新。</view>
    </view>
    <view class="card" wx:if="{{holiday.available}}">
      <view class="section-title">接下来的法定休息安排</view>
      <view class="holiday-row" wx:for="{{holiday.upcoming}}" wx:key="startDate">
        <view>
          <view class="holiday-name">{{item.name}} · {{item.days}} 天</view>
          <view class="meta">{{item.range}}</view>
        </view>
        <view class="countdown">{{item.countdown}}</view>
      </view>
      <view class="desc hint">数据与 Windows / Android 的中国节假日插件使用同一份离线快照，由同步脚本生成。</view>
    </view>
  </block>

  <!-- 轮换值日 -->
  <block wx:if="{{id === 'dorm-duty' && dd}}">
    <view class="card dd-alert" wx:if="{{dd.remindBanner.length}}">
      <view class="dd-alert-t" wx:for="{{dd.remindBanner}}" wx:key="group">今天轮到「{{item.name}}」{{item.group}}<text wx:if="{{item.location}}"> · {{item.location}}</text></view>
      <view class="meta">提醒时刻 {{dd.remindBanner[0].time}} · 小程序不常驻后台，只在打开本页时提示</view>
    </view>

    <!-- 一个插件里可以有多套轮换：宿舍值日 / 公区卫生…各有各的成员与周期，互不影响 -->
    <view class="card">
      <view class="section-title">轮换（{{dd.groupCount}}）</view>
      <view class="dd-gchips">
        <view class="dd-gtab" wx:for="{{dd.groups}}" wx:key="id">
          <text class="dd-gchip {{item.on ? 'on' : ''}}" data-id="{{item.id}}" bindtap="onDdGroup">{{item.name}}<text class="dd-gwho" wx:if="{{item.who}}">· {{item.who}}</text></text>
          <text class="dd-gmore" data-id="{{item.id}}" bindtap="onDdGroupMenu">⋯</text>
        </view>
      </view>
      <view class="dd-add">
        <button class="btn small pri dd-addbtn" bindtap="onDdGroupNew" disabled="{{!dd.canAddGroup}}">新建轮换</button>
      </view>
      <view class="desc hint">每套轮换各有自己的成员、周期、起始日与提醒时刻，互不影响。</view>
    </view>

    <view class="card">
      <view class="section-title">{{dd.groupName}} · {{dd.periodLabel}}一轮</view>
      <block wx:if="{{dd.empty}}">
        <view class="desc">还没有成员。先在下面「成员与轮换顺序」里添加成员，第一个人先当班。</view>
      </block>
      <block wx:elif="{{dd.paused}}">
        <view class="hero-status">假期 / 节日暂停中</view>
        <view class="meta">暂停期间不排班、不提醒，轮换停止计时。{{dd.nextStartText}}恢复，由 {{dd.nextWhoName}} 继续当班。</view>
      </block>
      <block wx:elif="{{!dd.started}}">
        <view class="hero-status">还没开始</view>
        <view class="meta">{{dd.nextStartText}}开始轮换。</view>
      </block>
      <block wx:else>
        <view class="dd-who">
          <text class="dd-big {{dd.currentIsMulti ? 'dd-big-multi' : ''}}">{{dd.currentNames}}</text>
          <text class="dd-badge" wx:if="{{dd.swapped}}">临时换人 · 原 {{dd.swapName}}</text>
        </view>
        <view class="meta">本轮 {{dd.cycleText}} · 第 {{dd.cycleIndex}} 轮{{dd.perRound > 1 ? ' · 每轮 ' + dd.perRound + ' 人' : ''}}</view>
        <view class="meta" wx:if="{{dd.currentLocation}}">今日地点：{{dd.currentLocation}}</view>
      </block>
      <view class="dd-actions">
        <button class="btn small pri" bindtap="onDdAddTask" disabled="{{!dd.current}}">加入今日任务</button>
        <button class="btn small" wx:if="{{dd.current}}" bindtap="onDdSwap">临时换人</button>
        <button class="btn small ghost" wx:if="{{dd.swapped}}" bindtap="onDdSwapClear">撤销换人</button>
      </view>
    </view>

    <view class="card" wx:if="{{dd.hasMembers}}">
      <view class="section-title">下次{{dd.nextVerb}}</view>
      <view class="dd-next">
        <text class="dd-big">{{dd.nextBigEm}}</text>
        <text class="dd-next-u">{{dd.nextBigUnit}}{{dd.nextVerb}}</text>
      </view>
      <view class="meta">{{dd.nextStartText}} · 轮到 {{dd.nextWhoName}}</view>
      <view class="dd-row" wx:for="{{dd.rows}}" wx:key="start">
        <view class="dd-row-top">
          <text class="dd-name">{{item.whoName}}</text>
          <text class="dd-tag" wx:if="{{item.swapped}}">换人</text>
        </view>
        <text class="dd-range">{{item.range}}</text>
        <text class="dd-days">{{item.daysText}} · 第 {{item.index}} 轮</text>
      </view>
    </view>

    <view class="card">
      <view class="section-title">地点轮换</view>
      <view class="meta" wx:if="{{dd.nextLocationStart}}">{{dd.started ? '下次换地点' : '地点轮换开始'}}：{{dd.nextLocationText}} · {{dd.nextLocationName}}</view>
      <view class="desc hint">地点和成员分别计时，均从起始日开始。</view>
      <view class="dd-field">
        <text class="label">每多少天换</text>
        <view class="dd-chips">
          <text class="dd-chip {{item.on ? 'on' : ''}}" wx:for="{{dd.locationPeriods}}" wx:key="days" data-days="{{item.days}}" bindtap="onDdLocationPeriod">{{item.label}}</text>
          <text class="dd-chip {{dd.locationPeriodCustom ? 'on' : ''}}" bindtap="onDdLocationPeriodCustom">自定义 {{dd.cfg.locationPeriodDays}} 天</text>
        </view>
      </view>
      <view class="dd-mrow" wx:for="{{dd.locations}}" wx:key="index">
        <text class="dd-mno">{{item.no}}</text>
        <view class="dd-mname" data-index="{{item.index}}" bindtap="onDdLocationRename">{{item.name}}</view>
        <view class="dd-mbtns">
          <button class="btn small dd-mini" data-index="{{item.index}}" bindtap="onDdLocationUp" disabled="{{!item.canUp}}">↑</button>
          <button class="btn small dd-mini" data-index="{{item.index}}" bindtap="onDdLocationDown" disabled="{{!item.canDown}}">↓</button>
          <button class="btn small dd-mini danger" data-index="{{item.index}}" bindtap="onDdLocationRemove">移除</button>
        </view>
      </view>
      <view class="dd-add">
        <input class="dd-in" placeholder="添加地点（如 走廊）" value="{{dd.newLocationName}}" maxlength="24" bindinput="onDdNewLocationInput" confirm-type="done" bindconfirm="onDdAddLocation" />
        <button class="btn small pri dd-addbtn" bindtap="onDdAddLocation" disabled="{{!dd.canAddLocation}}">添加</button>
      </view>
    </view>

    <view class="card">
      <view class="section-title">成员与轮换顺序（{{dd.members.length}}）</view>
      <view class="desc">按真实轮换顺序排列；“当班”标记表示今天值日。按住拖拽点或点 ↑↓ 调整顺序{{dd.perRound > 1 ? '，每轮 ' + dd.perRound + ' 人一起当班' : ''}}。</view>
      <view class="dd-mrow" wx:for="{{dd.members}}" wx:key="id">
        <text class="dd-mno">{{item.no}}</text>
        <text class="dd-drag {{dd.dragMemberId === item.id ? 'on' : ''}}" data-id="{{item.id}}" catchtouchstart="onDdDragStart" catchtouchmove="onDdDragMove" catchtouchend="onDdDragEnd" catchtouchcancel="onDdDragCancel">⋮⋮</text>
        <view class="dd-mname" data-id="{{item.id}}" bindtap="onDdRename">
          <text>{{item.name}}</text>
          <text class="dd-cur" wx:if="{{item.isCurrent}}">当班</text>
        </view>
        <view class="dd-mbtns">
          <button class="btn small dd-mini" data-id="{{item.id}}" bindtap="onDdMemberUp" disabled="{{!item.canUp}}">↑</button>
          <button class="btn small dd-mini" data-id="{{item.id}}" bindtap="onDdMemberDown" disabled="{{!item.canDown}}">↓</button>
          <button class="btn small dd-mini danger" data-id="{{item.id}}" bindtap="onDdMemberRemove">移除</button>
        </view>
      </view>
      <view class="dd-add">
        <input class="dd-in" placeholder="添加成员（如 小北）" value="{{dd.newMemberName}}" bindinput="onDdNewNameInput" confirm-type="done" bindconfirm="onDdAddMember" />
        <button class="btn small pri dd-addbtn" bindtap="onDdAddMember">添加</button>
      </view>
      <view class="dd-removed" wx:if="{{dd.removed.length}}">
        <view class="meta">已移除（点名字恢复到名单末尾）</view>
        <view class="dd-chips">
          <text class="dd-chip" wx:for="{{dd.removed}}" wx:key="id" data-id="{{item.id}}" bindtap="onDdRestore">{{item.name}}</text>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="section-title">设置</view>
      <view class="dd-field">
        <text class="label">轮换名</text>
        <input class="dd-in" value="{{dd.groupName}}" maxlength="12" bindblur="onDdGroupName" confirm-type="done" bindconfirm="onDdGroupName" />
      </view>
      <view class="dd-field">
        <text class="label">起始日</text>
        <picker mode="date" value="{{dd.cfg.startDate}}" bindchange="onDdStartDate">
          <view class="dd-pick">{{dd.cfg.startDate}}</view>
        </picker>
      </view>
      <view class="dd-field">
        <text class="label">轮换周期</text>
        <view class="dd-chips">
          <text class="dd-chip {{item.on ? 'on' : ''}}" wx:for="{{dd.periods}}" wx:key="days" data-days="{{item.days}}" bindtap="onDdPeriod">{{item.label}}</text>
        </view>
      </view>
      <view class="dd-field">
        <text class="label">每轮人数</text>
        <view class="dd-chips">
          <text class="dd-chip {{item.on ? 'on' : ''}}" wx:for="{{dd.perRounds}}" wx:key="n" data-n="{{item.n}}" bindtap="onDdPerRound">{{item.label}}</text>
        </view>
      </view>
      <view class="desc hint" wx:if="{{dd.perRound > 1}}">每轮按名单顺序 {{dd.perRound}} 人一起当班（如 3 人每轮 2 人：A、B → C、A → B、C），到点会一起提醒。</view>
      <view class="section-title">假期 / 节日暂停</view>
      <view class="desc hint">添加放假日期段（含首尾日期）。期间不值日、不提醒，成员和地点轮换均不计时；结束后接着原顺序继续。相邻或重叠日期自动合并。</view>
      <view class="dd-field" wx:for="{{dd.pauseRanges}}" wx:key="start">
        <text>{{item.start}} → {{item.end}}</text>
        <button class="btn small danger" data-index="{{index}}" bindtap="onDdPauseRemove">移除</button>
      </view>
      <view class="dd-field"><text class="label">开始日期</text><picker mode="date" value="{{dd.pauseStart}}" data-field="pauseStart" bindchange="onDdPauseDate"><view class="dd-pick">{{dd.pauseStart || '选择日期'}}</view></picker></view>
      <view class="dd-field"><text class="label">结束日期</text><picker mode="date" value="{{dd.pauseEnd}}" data-field="pauseEnd" bindchange="onDdPauseDate"><view class="dd-pick">{{dd.pauseEnd || '选择日期'}}</view></picker></view>
      <button class="btn small" bindtap="onDdPauseAdd">添加暂停</button>
      <view class="dd-field">
        <text class="label">到点提醒</text>
        <switch checked="{{dd.cfg.remindEnabled}}" bindchange="onDdRemindToggle" color="#0F4C5C" />
      </view>
      <view class="dd-field" wx:if="{{dd.cfg.remindEnabled}}">
        <text class="label">提醒时刻</text>
        <picker mode="time" value="{{dd.cfg.remindTime}}" bindchange="onDdRemindTime">
          <view class="dd-pick">{{dd.cfg.remindTime}}</view>
        </picker>
      </view>
      <view class="desc hint">提醒只在每轮第一天触发一次，不会天天催。小程序不能常驻后台，到点提醒只在打开本页时以横幅提示；需要系统通知请用 Windows / Android 端。</view>
      <view class="dd-add">
        <button class="btn small dd-mini danger" bindtap="onDdGroupDel" disabled="{{!dd.canDelGroup}}">删除这个轮换</button>
      </view>
      <view class="desc hint" wx:if="{{!dd.canDelGroup}}">至少要留一套轮换；想重来可以先改名、再清掉成员。</view>
    </view>
  </block>

  <!-- 拖入消息收纳（小程序以粘贴 / 手输为入口；记录与桌面端共用一份存储） -->
  <block wx:if="{{id === 'inbox-drop' && dropsWrap}}">
    <view class="card">
      <view class="section-title">把消息粘贴进来</view>
      <textarea class="id-ta" value="{{idInput}}" placeholder="把聊天里的通知复制到这里 —— 例如「【学习通】作业《高数》提交截止 2026-01-08 23:59，请及时提交。」&#10;也可以只写一句话，如「明天下午三点组会」。" bindinput="onIdInput" maxlength="2000" auto-height />
      <view class="id-acts">
        <button class="btn small" bindtap="onIdPaste">读剪贴板</button>
        <button class="btn small pri" bindtap="onIdAdd">收纳</button>
      </view>
      <view class="desc hint">会自动认出来源平台、消息类型和其中的日期时间；认错了可以在记录里改。同一条消息重复粘贴只会收一次。</view>
    </view>

    <view class="card">
      <view class="section-title">收纳区
        <text class="id-count" wx:if="{{dropsWrap.stats.total}}">共 {{dropsWrap.stats.total}} · 待处理 {{dropsWrap.stats.open}}</text>
      </view>

      <block wx:if="{{dropsWrap.empty}}">
        <view class="id-empty">还没有收纳记录</view>
        <view class="desc hint">上面粘一条消息试试。桌面 / Android 端拖进来的消息也会出现在这里。</view>
      </block>

      <block wx:else>
        <view class="id-row {{item.done ? 'done' : ''}}" wx:for="{{dropsWrap.drops}}" wx:key="id">
          <view class="id-top">
            <text class="id-seq" wx:if="{{item.seqLabel}}">{{item.seqLabel}}</text>
            <text class="id-title">{{item.title}}</text>
            <text class="id-pin" wx:if="{{item.pinned}}">置顶</text>
          </view>
          <view class="id-tags">
            <text class="id-tag" wx:if="{{item.platformLabel}}">{{item.platformLabel}}</text>
            <text class="id-tag" wx:if="{{item.typeLabel}}">{{item.typeLabel}}</text>
            <text class="id-tag" wx:if="{{item.when}}">{{item.when}}</text>
            <text class="id-tag" wx:if="{{item.source}}">{{item.source}}</text>
            <text class="id-tag" wx:if="{{item.sizeLabel}}">{{item.sizeLabel}}</text>
            <text class="id-tag ok" wx:if="{{item.doneLabel}}">{{item.doneLabel}}</text>
          </view>
          <view class="id-raw">{{item.raw}}</view>
          <view class="id-rowacts">
            <button class="btn small" bindtap="onIdTask" data-id="{{item.id}}" disabled="{{item.done === 'task'}}">建任务</button>
            <button class="btn small" bindtap="onIdBlock" data-id="{{item.id}}" disabled="{{item.done === 'block'}}">排日程</button>
            <button class="btn small ghost" bindtap="onIdPin" data-id="{{item.id}}">{{item.pinned ? '取消置顶' : '置顶'}}</button>
            <button class="btn small ghost" wx:if="{{item.done}}" bindtap="onIdReopen" data-id="{{item.id}}">撤销</button>
            <button class="btn small ghost danger" bindtap="onIdDel" data-id="{{item.id}}">删除</button>
          </view>
        </view>
      </block>

      <view class="id-foot" wx:if="{{dropsWrap.canClearDone}}">
        <button class="btn small ghost" bindtap="onIdClearDone">清除已处理的</button>
        <text class="desc hint">置顶的和还没处理的一律保留。</text>
      </view>
    </view>
  </block>

  <!-- 考试日历 -->
  <block wx:if="{{id === 'exam-calendar'}}">
    <view class="card">
      <view class="section-title">考试筛选</view>
      <picker mode="selector" range="{{examFilters}}" range-key="label" value="{{examFilterIndex}}" bindchange="onExamFilter">
        <view class="pickerbox">{{examFilters[examFilterIndex].label}}</view>
      </picker>
      <view class="exam-tools">
        <input class="exam-search" value="{{examQuery}}" placeholder="搜索考试名称" bindinput="onExamSearch" confirm-type="search" />
        <view class="exam-chip {{examConfirmedOnly ? 'on' : ''}}" bindtap="onToggleExamConfirmed">只看官方</view>
      </view>
      <view class="desc hint">选择某一项后，只显示该考试从报名、准考证到口试/笔试等已收录全流程。未来共 {{examTotal}} 场，当前显示 {{examVisible}} 场。</view>
    </view>

    <view class="card" wx:if="{{examFlow && examFlow.id !== 'all'}}">
      <view class="section-title">{{examFlow.label}} · 报名与全流程</view>
      <view class="desc">{{examFlow.registrationText}}</view>
      <view class="exam-notice" wx:if="{{examFlow.signupNotice}}">{{examFlow.signupNotice}}</view>
      <button wx:if="{{examFlow.signupUrl}}" class="btn ghost exam-signup" bindtap="onOpenExamSignup">{{examFlow.signupAction}}</button>
    </view>

    <view class="card">
      <view class="section-title">未来考试 · 同步桌面内嵌数据</view>
      <view class="desc" wx:if="{{!exams.length}}">当前筛选条件下没有更晚的考试安排。</view>
      <view class="exam {{item.hot ? 'hot' : ''}} {{item.confirmed ? '' : 'est'}}" wx:for="{{exams}}" wx:key="key">
        <view class="exam-head">
          <view class="exam-dcol">
            <view class="exam-d1">{{item.dateTop}}</view>
            <view class="exam-d2">{{item.dateBottom}}</view>
          </view>
          <view class="exam-bcol">
            <view class="exam-l1">
              <view class="exam-dot {{item.confirmed ? '' : 'est'}}"></view>
              <view class="exam-title">{{item.name}}</view>
              <view class="exam-tag" wx:if="{{item.type !== 'written'}}">{{item.typeName}}</view>
            </view>
            <view class="exam-l2">{{item.metaText}}</view>
          </view>
          <view class="exam-cd {{item.tone}}">{{item.countdown}}</view>
        </view>
        <view class="exam-actions">
          <button class="btn small ghost" data-key="{{item.key}}" bindtap="onExamFullFlow">看全流程</button>
          <button wx:if="{{!item.scheduled}}" class="btn small pri" data-key="{{item.key}}" bindtap="onAddExam">排进日程</button>
          <view wx:else class="exam-done">已在日程</view>
          <button wx:if="{{item.url}}" class="btn small ghost" data-key="{{item.key}}" bindtap="onCopyExamLink">{{item.linkLabel}}</button>
        </view>
      </view>
    </view>

    <view class="card" wx:if="{{examPastTotal}}">
      <view class="exam-hist-toggle" bindtap="onToggleExamHistory">
        <text>{{examPastOpen ? '收起' : '展开'}}历史场次（{{examPastTotal}} 场）</text>
        <text class="exam-hist-arrow">{{examPastOpen ? '▲' : '▼'}}</text>
      </view>
      <block wx:if="{{examPastOpen}}">
        <block wx:for="{{examPast}}" wx:for-item="grp" wx:key="year">
          <view class="exam-hist-year">{{grp.year}} 年 · {{grp.count}} 场</view>
          <view class="exam-hist-line" wx:for="{{grp.items}}" wx:for-item="p" wx:key="key">
            <text class="exam-hist-date">{{p.dateText}}</text>
            <text class="exam-hist-name">{{p.nameText}}</text>
          </view>
        </block>
      </block>
    </view>
  </block>

  <!-- 插件使用说明 -->
  <block wx:if="{{id === 'plugin-guide' && guide}}">
    <view class="card">
      <view class="section-title">按场景查看每个内置插件</view>
      <view class="desc">插件名称、说明和平台能力直接读取主程序插件清单，避免文档与实际清单分叉。标「原生适配」的可在小程序里直接打开使用。</view>
      <view class="guide-actions"><button class="btn ghost" bindtap="onGuideCopyRepo">复制项目仓库地址</button></view>
    </view>
    <view class="card" wx:for="{{guide.groups}}" wx:for-item="grp" wx:key="name">
      <view class="section-title">{{grp.name}}</view>
      <view class="guide-card {{item.native ? '' : 'off'}}" wx:for="{{grp.items}}" wx:for-item="item" wx:key="id">
        <view class="guide-top">
          <image class="guide-icon" src="{{item.iconPath}}" mode="aspectFit" />
          <view class="guide-copy">
            <view class="guide-name">{{item.name}}<text class="guide-native" wx:if="{{item.native}}">原生适配</text></view>
            <view class="meta">v{{item.version}} · {{item.platformText}}</view>
          </view>
        </view>
        <view class="guide-desc">{{item.desc}}</view>
        <view class="guide-steps">
          <view class="guide-step" wx:for="{{item.steps}}" wx:for-item="s" wx:for-index="si" wx:key="*this">{{si + 1}}. {{s}}</view>
        </view>
      </view>
    </view>
    <view class="card"><view class="desc hint">安全提示：外部 ZIP 插件属于受信任扩展模型，只安装来源可信、你已审核过的插件。</view></view>
  </block>

  <!-- 微信提醒推送 -->
  <block wx:if="{{id === 'wechat-push' && push}}">
    <view class="card">
      <view class="section-title">微信推送通道 · PushPlus</view>
      <view class="desc">推荐 PushPlus：复制下方「一键获取 Token」地址到浏览器打开，微信扫码登录后复制页面上的 Token 粘贴回来。旧版 Server酱 配置保留兼容。</view>
      <view class="push-docs">
        <view class="push-link" data-url="https://www.pushplus.plus/doc/guide/sdk.html" bindtap="onPushCopy">官方文档：使用说明 / SDK ↗（点击复制）</view>
        <view class="push-link" data-url="https://www.pushplus.plus/doc/guide/api.html" bindtap="onPushCopy">消息接口文档（参数与返回码）↗</view>
      </view>
      <view class="push-provider">
        <view class="push-pro {{push.provider === 'pushplus' ? 'on' : ''}}" data-p="pushplus" bindtap="onPushProvider">PushPlus（推荐）</view>
        <view class="push-pro {{push.provider === 'serverchan' ? 'on' : ''}}" data-p="serverchan" bindtap="onPushProvider">Server酱（兼容）</view>
      </view>
      <block wx:if="{{push.provider === 'pushplus'}}">
        <view class="push-field"><view class="label">PushPlus Token</view>
          <input password="{{!push.showKey}}" value="{{push.token}}" data-k="token" bindinput="onPushField" placeholder="粘贴 Token" />
        </view>
        <button class="btn ghost push-btn" data-url="https://www.pushplus.plus/push1.html" bindtap="onPushCopy">↗ 复制「一键获取 Token」页面地址</button>
        <view class="push-field"><view class="label">Topic（可选，群组编码）</view>
          <input value="{{push.topic}}" data-k="topic" bindinput="onPushField" placeholder="不填则只推送给自己" />
        </view>
      </block>
      <block wx:else>
        <view class="push-field"><view class="label">Server酱 SendKey</view>
          <input password="{{!push.showKey}}" value="{{push.oldKey}}" data-k="oldKey" bindinput="onPushField" placeholder="SCT…" />
        </view>
      </block>
      <view class="push-switches">
        <view class="push-switch"><switch checked="{{push.enabled}}" data-k="enabled" bindchange="onPushSwitch" color="#2EC4B6" /><text>启用微信推送</text></view>
        <view class="push-switch"><switch checked="{{push.blockEnabled}}" data-k="blockEnabled" bindchange="onPushSwitch" color="#2EC4B6" /><text>时间块提醒</text></view>
        <view class="push-switch"><switch checked="{{push.taskEnabled}}" data-k="taskEnabled" bindchange="onPushSwitch" color="#2EC4B6" /><text>任务截止提醒</text></view>
      </view>
      <view class="custom-row">
        <text class="label flex-none">时间块提前</text>
        <picker mode="selector" range="{{push.leadOptions}}" value="{{push.leadIndex}}" bindchange="onPushLead">
          <view class="pickerbox">{{push.lead}} 分钟</view>
        </picker>
      </view>
      <view class="controls">
        <button class="btn ghost" bindtap="onPushToggleShow">{{push.showKey ? '隐藏凭据' : '显示/隐藏凭据'}}</button>
        <button class="btn pri" bindtap="onPushTest">发送测试消息</button>
      </view>
      <view class="desc hint">小程序内推送只在插件页打开期间每分钟检查一次；桌面 / Android 端开启后可全天候推送。推送域名 www.pushplus.plus / sctapi.ftqq.com 在正式版需登记到小程序后台合法域名。</view>
      <view class="push-log" wx:if="{{push.log.length}}">
        <view class="section-title">推送记录</view>
        <view class="push-logline {{item[1] === '✗' ? 'bad' : ''}}" wx:for="{{push.log}}" wx:key="*this">{{item}}</view>
      </view>
    </view>
  </block>

  <!-- 竞赛消息雷达 -->
  <block wx:if="{{id === 'gx-news' && gx}}">
    <view class="card">
      <view class="gx-toolbar">
        <button class="btn pri gx-refresh" bindtap="onGxRefresh" disabled="{{gx.fetching}}">刷新</button>
        <input class="gx-kw" value="{{gx.kw}}" placeholder="关键词：答辩 / 数学 / 报名 / 截止…" bindinput="onGxKw" confirm-type="search" />
      </view>
      <view class="gx-chips">
        <view class="gx-chip {{item.on ? 'on' : ''}}" wx:for="{{gx.typeChips}}" wx:key="id" data-id="{{item.id}}" bindtap="onGxType">{{item.label}}</view>
        <view class="gx-chip {{gx.hideSeen ? 'on' : ''}}" bindtap="onGxToggleSeen">只看未读</view>
      </view>
      <view class="gx-chips" wx:if="{{gx.monthChips.length > 1}}">
        <view class="gx-chip {{item.on ? 'on' : ''}}" wx:for="{{gx.monthChips}}" wx:key="id" data-id="{{item.id}}" bindtap="onGxMonth">{{item.label}}</view>
      </view>
      <view class="gx-status {{gx.error ? 'err' : ''}}">
        <text wx:if="{{gx.error}}">抓取失败：{{gx.error}}（点「刷新」重试；模拟器/体验版请勾选「不校验合法域名」）</text>
        <text wx:else>{{gx.status}}</text>
      </view>
      <block wx:for="{{gx.rows}}" wx:key="key">
        <view wx:if="{{item.kind === 'month'}}" class="gx-month">{{item.label}}</view>
        <view wx:else class="gx-card {{item.seen ? 'seen' : ''}}" data-id="{{item.id}}" bindtap="onGxTap" data-act="open">
          <view class="gx-main">
            <view class="gx-title">{{item.title}}<text class="gx-new" wx:if="{{item.isNew}}">NEW</text></view>
            <view class="gx-meta"><text class="gx-tag {{item.tagHot ? 'hot' : ''}}">{{item.tagName}}</text><text>{{item.time}}</text></view>
            <view class="gx-snip" wx:if="{{item.snippet}}">{{item.snippet}}</view>
          </view>
          <button class="btn small ghost gx-remind" data-id="{{item.id}}" data-act="remind" catchtap="onGxTap">提醒</button>
        </view>
      </block>
      <view class="empty" wx:if="{{!gx.rows.length && !gx.fetching}}">{{gx.count ? "没有符合过滤条件的消息，试试换个关键词或切回「全部」" : "还没有消息，点上方「刷新」抓取"}}</view>
      <button class="btn ghost gx-more" wx:if="{{gx.rows.length && gx.more !== 'end'}}" bindtap="onGxMore" disabled="{{gx.fetching}}">{{gx.moreText}}</button>
      <view class="desc hint">消息详情在浏览器打开：点卡片会复制详情链接。识别到日期的竞赛通知可用「提醒」按钮一键转成 Le 提醒。</view>
    </view>
  </block>

  <!-- 学习通 -->
  <block wx:if="{{id === 'chaoxing-notify' && cx}}">
    <block wx:if="{{cx.mode === 'login'}}">
      <view class="card">
        <view class="section-title">登录学习通</view>
        <view class="modes cx-login-tabs">
          <button class="mode {{cx.loginTab === 'pwd' ? 'on' : ''}}" data-t="pwd" bindtap="onCxLoginTab">账号密码</button>
          <button class="mode {{cx.loginTab === 'cookie' ? 'on' : ''}}" data-t="cookie" bindtap="onCxLoginTab">Cookie 登录</button>
        </view>
        <block wx:if="{{cx.loginTab === 'pwd'}}">
          <view class="push-field"><view class="label">账号（手机号 / 学号）</view>
            <input value="{{cx.uname}}" data-k="uname" bindinput="onCxField" placeholder="学习通账号" />
          </view>
          <view class="push-field"><view class="label">密码</view>
            <input password value="{{cx.pwd}}" data-k="pwd" bindinput="onCxField" placeholder="密码（DES 加密后传输，不明文保存）" />
          </view>
          <view class="cx-check"><switch checked="{{cx.remember}}" bindchange="onCxRemember" color="#2EC4B6" /><text>保存登录信息到本机</text></view>
          <button class="btn pri cx-wide" bindtap="onCxLogin" disabled="{{cx.loading}}">{{cx.loading ? '登录中…' : '登录并同步'}}</button>
        </block>
        <block wx:else>
          <view class="push-field"><view class="label">Cookie</view>
            <textarea class="cx-textarea" value="{{cx.cookieInput}}" data-k="cookieInput" bindinput="onCxField" placeholder="粘贴学习通 Cookie（可从桌面端插件复制，需包含 UID / FUID / VC3 等字段）" />
          </view>
          <button class="btn pri cx-wide" bindtap="onCxLoginCookie" disabled="{{cx.loading}}">验证会话并进入</button>
        </block>
        <view class="cx-error" wx:if="{{cx.error}}">{{cx.error}}</view>
        <view class="desc hint">Cookie 等同账号登录身份，仅在选择保存时写入本机、随备份 JSON 同步，请勿外传。个别机型 wx.request 拿不到 Set-Cookie，账号密码登录后会话无法保持，此时请改用 Cookie 登录。</view>
      </view>
    </block>
    <block wx:else>
      <view class="card">
        <view class="cx-actions">
          <button class="btn pri" bindtap="onCxRefresh" disabled="{{cx.loading}}">{{cx.loading ? '刷新中…' : '快速刷新'}}</button>
          <button class="btn ghost" bindtap="onCxRestore" wx:if="{{cx.ignoredCount}}">恢复已移除（{{cx.ignoredCount}}）</button>
          <button class="btn ghost" bindtap="onCxLogout">切换登录</button>
        </view>
        <view class="modes cx-nav">
          <button class="mode {{cx.tab === 'inbox' ? 'on' : ''}}" data-t="inbox" bindtap="onCxTab">收件箱 {{cx.visibleCount}}</button>
          <button class="mode {{cx.tab === 'todo' ? 'on' : ''}}" data-t="todo" bindtap="onCxTab">待办 {{cx.todoCount}}</button>
          <button class="mode {{cx.tab === 'courses' ? 'on' : ''}}" data-t="courses" bindtap="onCxTab">课程 {{cx.courseCount}}</button>
          <button class="mode {{cx.tab === 'lookup' ? 'on' : ''}}" data-t="lookup" bindtap="onCxTab">分享码查询</button>
        </view>
        <view class="cx-error" wx:if="{{cx.error}}">{{cx.error}}</view>
        <view class="meta">{{cx.statusText}}</view>
      </view>

      <!-- 收件箱 -->
      <block wx:if="{{cx.tab === 'inbox'}}">
        <view class="card">
          <view class="cx-toolbar">
            <input class="cx-search" value="{{cx.filterKw}}" placeholder="搜索标题 / 正文 / 发送者…" bindinput="onCxSearch" confirm-type="search" />
            <picker mode="selector" range="{{cx.catOptions}}" value="{{cx.filterCatIndex}}" bindchange="onCxCat">
              <view class="pickerbox cx-cat">{{cx.catOptions[cx.filterCatIndex]}}</view>
            </picker>
          </view>
          <view class="cx-check cx-unread-toggle"><switch checked="{{cx.onlyUnread}}" bindchange="onCxUnread" color="#2EC4B6" /><text>只看未读（含本机标记）</text></view>
          <view class="cx-kpis">
            <text class="cx-kpi">本次新增 {{cx.newCount}}</text>
            <text class="cx-kpi">未读 {{cx.unreadCount}}</text>
            <text class="cx-kpi">显示 {{cx.visibleCount}} / 共 {{cx.totalCount}}</text>
          </view>
          <view class="empty" wx:if="{{!cx.inboxRows.length}}">没有匹配的通知。点上方「快速刷新」拉取收件箱。</view>
          <view class="cx-card {{item.unread ? 'unread' : ''}} cat-{{item.catCls}} {{item.expanded ? 'open' : ''}}" wx:for="{{cx.inboxRows}}" wx:key="key">
            <view class="cx-title" data-id="{{item.key}}" bindtap="onCxRowToggle">{{item.title}}<text class="cx-pill new" wx:if="{{item.isNew}}">NEW</text><text class="cx-pill grading" wx:if="{{item.grading}}">正在批改</text></view>
            <view class="cx-meta"><text class="cx-tag {{item.catCls}}">{{item.cat}}</text><text wx:if="{{item.sender}}">{{item.sender}}</text><text>{{item.time}}</text><text>{{item.unread ? '未读' : '已读'}}</text><text wx:if="{{item.linkHint}}" class="cx-pill">{{item.linkHint}}</text></view>
            <view class="cx-body">{{item.body}}</view>
            <view class="cx-card-actions">
              <button class="btn small ghost" data-id="{{item.key}}" bindtap="onCxRemind">转为提醒</button>
              <button class="btn small ghost" data-id="{{item.key}}" bindtap="onCxMark">{{item.unread ? '标记已读' : '标记未读'}}</button>
              <button class="btn small ghost" data-id="{{item.key}}" bindtap="onCxCopyLink">复制链接</button>
              <button class="btn small danger" data-id="{{item.key}}" bindtap="onCxIgnore">移除</button>
            </view>
          </view>
          <view class="desc hint">已读/未读标记只影响本机显示与筛选；「移除」只在本机列表隐藏，可用顶部「恢复已移除」放回，都不影响学习通平台数据。</view>
        </view>
      </block>

      <!-- 待办作业 -->
      <block wx:if="{{cx.tab === 'todo'}}">
        <view class="card">
          <view class="empty" wx:if="{{!cx.todoRows.length}}">当前拉取范围内没有识别到未截止作业。识别规则：正文中的「结束时间 / 截止时间：YYYY-MM-DD HH:MM」。</view>
          <view class="cx-card cat-work" wx:for="{{cx.todoRows}}" wx:key="key">
            <view class="cx-title">{{item.title}}<text class="cx-pill grading" wx:if="{{item.grading}}">正在批改</text></view>
            <view class="cx-meta"><text class="cx-tag work">作业</text><text wx:if="{{item.sender}}">{{item.sender}}</text></view>
            <view class="cx-due">截止 {{item.dueText}}</view>
            <view class="cx-body">{{item.body}}</view>
            <view class="cx-card-actions">
              <button class="btn small pri" data-id="{{item.key}}" bindtap="onCxRemind">加入时间管理</button>
              <button class="btn small ghost" data-id="{{item.key}}" bindtap="onCxCopyLink">复制链接</button>
            </view>
          </view>
        </view>
      </block>

      <!-- 课程 -->
      <block wx:if="{{cx.tab === 'courses'}}">
        <view class="card">
          <view class="cx-toolbar">
            <input class="cx-search" value="{{cx.filterKw}}" placeholder="搜索课程 / 教师 / 班级…" bindinput="onCxSearch" confirm-type="search" />
          </view>
          <picker mode="selector" range="{{cx.courseYears}}" range-key="label" value="{{cx.courseYearIndex}}" bindchange="onCxYear" wx:if="{{cx.courseYears.length}}">
            <view class="pickerbox">{{cx.courseYears[cx.courseYearIndex].label}}（{{cx.courseYears[cx.courseYearIndex].count}} 门）</view>
          </picker>
          <view class="empty" wx:if="{{!cx.courseGroups.length}}">这个学年没有课程；先「快速刷新」同步课程列表。</view>
          <view class="cx-status-sec" wx:for="{{cx.courseGroups}}" wx:for-item="grp" wx:key="key">
            <view class="cx-grade-head"><view class="cx-dot dot-{{grp.key}}"></view>{{grp.label}}<text class="meta"> {{grp.count}} 门</text></view>
            <view class="cx-course st-{{c.status}}" wx:for="{{grp.items}}" wx:for-item="c" wx:key="key">
              <view class="cx-course-name">{{c.name}}<text class="cx-mark st-{{c.status}}">{{grp.label}}</text></view>
              <view class="meta">{{c.sub}}</view>
              <view class="meta">{{c.termLine}}</view>
            </view>
          </view>
          <view class="desc hint">卡片底色与角标是按课程卡片里的「开课时间」本地推断的完成状态（红=未完成 / 蓝=正在进行 / 绿=已完成），学习通接口本身不返回该状态，可能与平台显示不一致。</view>
        </view>
      </block>

      <!-- 分享码查询 -->
      <block wx:if="{{cx.tab === 'lookup'}}">
        <view class="card">
          <view class="push-field"><view class="label">通知分享码 / 分享链接</view>
            <input value="{{cx.lookupCode}}" data-k="lookupCode" bindinput="onCxField" placeholder="粘贴 32 位 idCode 或学习通分享链接" />
          </view>
          <button class="btn pri cx-wide" bindtap="onCxLookup" disabled="{{cx.loading}}">查询全文</button>
          <view class="empty" wx:if="{{!cx.lookupResult}}">收件箱本身已包含通知全文；这里用于按分享码单独查询。</view>
          <block wx:if="{{cx.lookupResult}}">
            <view class="cx-card open">
              <view class="cx-title">{{cx.lookupResult.title}}</view>
              <view class="cx-meta"><text wx:if="{{cx.lookupResult.sender}}">{{cx.lookupResult.sender}}</text><text>{{cx.lookupResult.time}}</text><text wx:if="{{cx.lookupResult.toNames}}">发送给 {{cx.lookupResult.toNames}}</text></view>
              <view class="cx-body">{{cx.lookupResult.body}}</view>
              <view class="cx-card-actions">
                <button class="btn small pri" bindtap="onCxLookupRemind">转为提醒</button>
                <button class="btn small ghost" data-url="https://sharewh3.xuexi365.com/share/{{cx.lookupResult.idCode}}?t=4" bindtap="onPushCopy">复制分享页链接</button>
              </view>
            </view>
          </block>
        </view>
      </block>
    </block>
  </block>
</view>
