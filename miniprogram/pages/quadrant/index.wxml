<view class="page-body">
  <view class="mini-shortcuts"><button class="btn ghost small" bindtap="onInbox">收件箱 {{inboxCount}}</button><button class="btn ghost small" bindtap="onSchedulePlugin">课程表</button><button class="btn ghost small" bindtap="onPlugins">插件中心</button></view>
  <!-- 搜索 -->
  <view class="searchbar">
    <view class="search-wrap">
      <view class="search-ico"></view>
      <input
        class="input"
        aria-label="搜索任务 / 备注 / 项目 / 标签"
        value="{{q}}"
        confirm-type="search"
        bindinput="onSearch"
      />
    </view>
    <text wx:if="{{q}}" class="search-clear" bindtap="onClearSearch">清除</text>
  </view>

  <!-- 顶部统计 + 折叠开关 -->
  <view class="chips">
    <view class="chip">全部 <text class="count">{{chips.all}}</text> 项</view>
    <view class="chip">待办 <text class="count">{{chips.open}}</text> 项</view>
    <view class="chip">已完成 <text class="count">{{chips.done}}</text> 项</view>
    <view class="chip toggle {{hideDone ? 'on' : ''}}" hover-class="press" bindtap="onHideDoneTap">
      {{hideDone ? "已隐藏已完成" : "隐藏已完成"}}
    </view>
  </view>

  <view class="mini-filters"><button class="btn ghost small" data-filter="quad" bindtap="onFilterTap">本象限</button><button class="btn ghost small" data-filter="all" bindtap="onFilterTap">全部</button><button class="btn ghost small" data-filter="today" bindtap="onFilterTap">今日截止</button><button class="btn ghost small" data-filter="overdue" bindtap="onFilterTap">逾期</button><button class="btn ghost small" data-filter="pool" bindtap="onFilterTap">未排今日</button><button class="btn small {{selecting ? 'pri' : 'ghost'}}" bindtap="onSelectMode">{{selecting ? '结束选择' : '批量操作'}}</button><button class="btn ghost small" bindtap="onClearDone">清理已完成</button></view>
  <view wx:if="{{selecting}}" class="mini-bulk"><text>已选 {{selectedCount}} 项</text><view class="mini-filters"><button class="btn ghost small" bindtap="onSelectPage">选择当前页</button><button class="btn ghost small" disabled="{{!selectedCount}}" data-done="true" bindtap="onBulkDone">完成</button><button class="btn ghost small" disabled="{{!selectedCount}}" data-done="false" bindtap="onBulkDone">未完成</button><button class="btn ghost small" disabled="{{!selectedCount}}" bindtap="onBulkMove">移动象限</button><button class="btn danger small" disabled="{{!selectedCount}}" bindtap="onBulkDelete">删除选中</button></view></view>
  <!-- 搜索结果 / 象限块 -->
  <block wx:if="{{searching}}">
    <view class="qhead">
      <view class="qh-line"><text class="qh-title">{{searchLabel}} · {{total}} 个</text></view>
      <view class="qh-tip">支持标题 / 备注 / 项目 / 标签；长按任务可排序和移动象限</view>
    </view>
  </block>
  <block wx:else>
    <view class="qgrid">
      <view
        wx:for="{{quads}}"
        wx:key="q"
        class="qtile {{item.cls}} {{active === item.q ? 'on' : ''}}"
        data-q="{{item.q}}"
        hover-class="press"
        bindtap="onTileTap"
      >
        <view class="qt-top">
          <text class="rn">{{item.rn}}</text>
          <text class="cnt">{{item.open}} 项待办</text>
        </view>
        <view class="qt-name">{{item.short}}</view>
        <view class="qt-tip">{{item.tip}}</view>
      </view>
    </view>

    <view class="qhead {{cur.cls}}">
      <view class="qh-line">
        <text class="rn-big">{{cur.rn}}</text>
        <text class="qh-title">{{cur.title}}</text>
      </view>
      <view class="qh-tip">{{cur.tip}}</view>
    </view>
  </block>

  <!-- 任务列表（左滑出快捷操作） -->
  <view class="tks">
    <view wx:for="{{tasks}}" wx:key="id" class="swipe-wrap">
      <view class="swipe-actions">
        <view class="sa s-done" data-id="{{item.id}}" catchtap="onSwipeDone">{{item.done ? "↩" : "✓"}}</view>
        <view class="sa s-del" data-id="{{item.id}}" catchtap="onSwipeDel">✕</view>
      </view>
      <view
        class="tkc {{item.done ? 'done' : ''}}"
        style="transform: translateX({{item.offset}}px); {{item.moving ? '' : 'transition: transform .18s ease-out;'}}"
        data-id="{{item.id}}"
        data-index="{{item.index}}"
        data-offset="{{item.offset}}"
        hover-class="press"
        bindtap="onCardTap"
        bindlongpress="onTaskMenu"
        bindtouchstart="onCardTouchStart"
        bindtouchmove="onCardTouchMove"
        bindtouchend="onCardTouchEnd"
        bindtouchcancel="onCardTouchCancel"
      >
        <view class="cb {{(selecting ? item.selected : item.done) ? 'on' : ''}}" data-id="{{item.id}}" catchtap="onCheck">{{(selecting ? item.selected : item.done) ? '✓' : ''}}</view>
        <view class="tbody">
          <view class="tt">
            <text wx:if="{{searching}}" class="qb {{item.quadCls}}">{{item.quadBadge}}</text>
            {{item.title}}
          </view>
          <view
            wx:if="{{item.hasNote}}"
            class="tn {{item.noteOpen ? 'open' : ''}}"
            data-id="{{item.id}}"
            catchtap="onNoteTap"
          >{{item.note}}</view>
          <view class="m">{{item.meta}}</view>
        </view>
        <view class="side">
          <view wx:if="{{item.schedLabel}}" class="sch">{{item.schedLabel}}</view>
          <view class="est">{{item.estLabel}}</view>
        </view>
      </view>
    </view>
    <view wx:if="{{!tasks.length}}" class="empty">{{searching ? "没有匹配的任务" : "这个象限还是空的"}}</view>
  </view>

  <view class="mini-filters"><button wx:if="{{hasPrev}}" class="btn ghost small" bindtap="onPrevPage">上一页</button><text class="desc">第 {{pageNumber}} 页 · 共 {{total}} 条</text><button wx:if="{{hasNext}}" class="btn ghost small" bindtap="onNextPage">下一页</button></view>
  <!-- 快速添加 -->
  <view wx:if="{{form.show}}" class="addform">
    <input
      class="input"
      placeholder="要做什么？"
      value="{{form.title}}"
      focus="{{form.focus}}"
      confirm-type="done"
      bindinput="onFormInput"
      bindconfirm="onFormSave"
    />
    <view class="formrow">
      <picker mode="selector" range="{{estLabels}}" value="{{form.estIndex}}" bindchange="onEstChange">
        <view class="estpick">预估 {{estLabels[form.estIndex]}} ▾</view>
      </picker>
      <view class="formbtns">
        <button class="btn ghost small" bindtap="onFormCancel">取消</button>
        <button class="btn pri small" bindtap="onFormSave">保存</button>
      </view>
    </view>
  </view>
  <button wx:else class="btn ghost block addbtn" bindtap="onAddTap">添加到「{{cur.short}}」</button>
  <view wx:if="{{undoMessage}}" class="mini-undo"><text>{{undoMessage}}</text><button class="btn ghost small" bindtap="onUndo">撤销</button></view>
</view>
