/* ═══════════════════════════════════════════════════════════
   U-Time · 小程序设计系统
   与桌面端 src/styles.css 同源：
   03「权衡」四象限（纸面质感、四色象限）
   04「潮汐」时间块（暖沙底、深青/珊瑚/日黄/海蓝）
   ═══════════════════════════════════════════════════════════ */
page {
  --bg: #F2EFEA;            /* 暖沙底（潮汐） */
  --paper: #F7F6F2;         /* 纸面（权衡） */
  --panel: #FFFFFF;
  --ink: #22303A;
  --ink-2: #7E8B94;
  --ink-3: #A9B2BA;
  --line: #E4DFD6;
  --line-soft: #EFEAE1;

  --deep: #0F4C5C;          /* 深青 · 主操作 */
  --deep-2: #12333D;        /* 导航栏 */
  --sea: #118AB2;
  --coral: #FF6B6B;
  --sun: #E3A008;
  --grape: #9B5DE5;
  --mint: #2EC4B6;

  /* 四象限（底色与桌面 styles.css 默认主题同步） */
  --q1: #D64545; --q1-bg: #FFB8B3;
  --q2: #D9A13B; --q2-bg: #F6D48F;
  --q3: #5B6BE8; --q3-bg: #BEC8FF;
  --q4: #5B8F7B; --q4-bg: #B7D9CB;

  /* 功能色 */
  --accent-soft: #DCEAEF;   /* 节奏图「今天」柱底 */
  --danger-bg: #FDECEC;
  --danger-ink: #C43C3C;
  --on-deep: #FFFFFF;       /* 深青主色之上的文字 */

  background: var(--bg);
  color: var(--ink);
  font-size: 28rpx;
  font-family: "PingFang SC", "Microsoft YaHei", "Noto Sans CJK SC", sans-serif;
  min-height: 100vh;
}

/* ── 暗色模式（app.json darkmode: true 时生效） ── */
@media (prefers-color-scheme: dark) {
  page {
    --bg: #141B20;
    --paper: #1B242A;
    --panel: #212C33;
    --ink: #E2E8EB;
    --ink-2: #94A2AA;
    --ink-3: #61707A;
    --line: #33424C;
    --line-soft: #2A3840;

    --deep: #58A8BE;
    --deep-2: #0D1F26;
    --sea: #3FB0DA;
    --coral: #FF8080;
    --sun: #EAB33C;
    --grape: #B07DF0;
    --mint: #3ED2C4;

    --q1: #E07A7A; --q1-bg: #3B2727;
    --q2: #E2B767; --q2-bg: #3A3120;
    --q3: #8F9AF0; --q3-bg: #272C47;
    --q4: #82B6A0; --q4-bg: #23342D;

    --accent-soft: #1C3B47;
    --danger-bg: #3B2727;
    --danger-ink: #E08A8A;
    --on-deep: #08202A;
  }
}

/* ── 通用布局 ── */
.page-body {
  min-height: 100vh;
  padding: calc(20rpx + env(safe-area-inset-top)) 24rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.card {
  background: var(--panel);
  border-radius: 22rpx;
  box-shadow: 0 2rpx 12rpx rgba(34, 48, 58, 0.055);
  padding: 26rpx;
  margin-bottom: 22rpx;
}
.sec-title {
  font-size: 22rpx;
  letter-spacing: 0.2em;
  color: var(--ink-2);
  margin: 6rpx 4rpx 14rpx;
}
.desc {
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.65;
}
.empty {
  color: var(--ink-3);
  font-size: 24rpx;
  text-align: center;
  padding: 30rpx 0;
  line-height: 1.7;
}

/* ── 按钮 ── */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 88rpx;
  font-size: 26rpx;
  padding: 16rpx 28rpx;
  border-radius: 14rpx;
  line-height: 1.2;
  border: none;
}
.btn::after { border: none; }
.btn:active { transform: scale(0.99); opacity: 0.92; }
.btn.pri { background: var(--deep); color: var(--on-deep); font-weight: 600; }
.btn.ghost { background: transparent; color: var(--deep); border: 2rpx solid var(--line); }
.btn.danger { background: var(--danger-bg); color: var(--danger-ink); }
.btn.small { min-height: 68rpx; font-size: 23rpx; padding: 10rpx 20rpx; }
.btn.block { display: flex; width: 100%; }
.btn[disabled] { opacity: 0.45; }

/* ── 输入 ── */
.input,
.textarea {
  background: var(--paper);
  border: 2rpx solid var(--line);
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  font-size: 27rpx;
  color: var(--ink);
  width: 100%;
  box-sizing: border-box;
}
.input { min-height: 82rpx; }
.textarea { min-height: 160rpx; }

/* ── 搜索框 ──
   用户要求「删除所有搜索框内的中文，仅保留搜索图标」：框里不再写中文占位词，
   左端只留一颗放大镜。图标用纯 CSS 画（圆环 + 斜柄），不依赖任何图片资源，
   深浅模式跟着 --ink-3 走；提示语改挂 aria-label，读屏仍然知道这个框能搜什么。 */
.search-wrap {
  position: relative;
  display: flex;
  align-items: center;
  min-width: 0;
}
.search-wrap > input {
  flex: 1 1 auto;
  min-width: 0;
  padding-left: 62rpx;
}
.search-ico {
  position: absolute;
  left: 20rpx;
  top: 50%;
  width: 30rpx;
  height: 30rpx;
  margin-top: -15rpx;
  pointer-events: none;
}
.search-ico::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  width: 21rpx;
  height: 21rpx;
  box-sizing: border-box;
  border: 3rpx solid var(--ink-3);
  border-radius: 50%;
}
.search-ico::after {
  content: "";
  position: absolute;
  right: 0;
  bottom: 0;
  width: 13rpx;
  height: 3rpx;
  border-radius: 3rpx;
  background: var(--ink-3);
  transform: rotate(45deg);
}

@media (max-width: 340px) {
  .page-body { padding-left: 18rpx; padding-right: 18rpx; }
  .card { padding: 22rpx; border-radius: 20rpx; }
  .btn { font-size: 25rpx; padding-left: 22rpx; padding-right: 22rpx; }
}

/* ── 分类色 ──
   一种类型一种颜色，映射与桌面端 styles.css 的 --cat-* 完全一致：
   工作=黄 / 学习=蓝 / 运动=红 / 生活=紫 / 休息=青绿。
   值一律引用令牌（深色模式那段会重定义 --sun 等），不写死十六进制。 */
.cat-work { background: var(--sun); }
.cat-study { background: var(--sea); }
.cat-sport { background: var(--coral); }
.cat-life { background: var(--grape); }
.cat-rest { background: var(--mint); }
.cat-pill {
  display: inline-block;
  font-size: 20rpx;
  color: var(--on-deep);
  border-radius: 8rpx;
  padding: 3rpx 12rpx;
  line-height: 1.4;
}
/* 药丸上的字必须跟着分类底色走：黄 / 红 / 青绿底太亮，白字只有 2.2~2.8:1（桌面端实测同值）。
   ⚠️ 选择器要写 .cat-pill.cat-*，**不要**写 .cat-*：后者是全局类名，插件页的
   `.cx-card.cat-work`（那里表示「通知类型」，不是任务分类）也会命中，
   给它一个固定的深色 color 会让深色模式下卡片正文变成深色、糊在深色底上。 */
.cat-pill.cat-work { color: #17323A; }
.cat-pill.cat-study { color: var(--on-deep); }
.cat-pill.cat-sport { color: #3A1512; }
.cat-pill.cat-life { color: var(--on-deep); }
.cat-pill.cat-rest { color: #0E2A26; }

/* v0.9 · 参考 tauri-app-template 的统一组件风格 */
page {
  --ui-radius: 20rpx;
  --ui-radius-sm: 14rpx;
  --ui-shadow: 0 2rpx 6rpx rgba(15, 23, 42, .035);
  --ui-hover: rgba(15, 23, 42, .04);
}
.page-body {
  padding-left: 22rpx;
  padding-right: 22rpx;
}
.card {
  border: 2rpx solid var(--line);
  border-radius: var(--ui-radius);
  box-shadow: var(--ui-shadow);
  padding: 24rpx;
  margin-bottom: 18rpx;
}
.sec-title {
  letter-spacing: .12em;
  font-size: 21rpx;
  margin-bottom: 12rpx;
}
.btn {
  min-height: 78rpx;
  padding: 14rpx 24rpx;
  border-radius: var(--ui-radius-sm);
  font-size: 25rpx;
}
.btn.ghost {
  background: var(--panel);
  border: 2rpx solid var(--line);
  color: var(--ink);
}
.btn.small { min-height: 62rpx; padding: 8rpx 18rpx; }
.input, .textarea {
  background: var(--panel);
  border-radius: var(--ui-radius-sm);
  padding: 14rpx 18rpx;
}
.input { min-height: 76rpx; }
.empty {
  border: 2rpx dashed var(--line);
  border-radius: var(--ui-radius-sm);
  background: var(--paper);
  padding: 26rpx 18rpx;
}

/* 原生增强入口 / 批量操作 / 可撤销反馈，沿用系统深浅色变量。 */
.mini-shortcuts,.mini-filters { display:flex; flex-wrap:wrap; align-items:center; margin:12rpx -5rpx; }
.mini-shortcuts .btn,.mini-filters .btn { margin:5rpx; }
.mini-filters .desc { margin:8rpx; }
.mini-undo { position:fixed; left:20rpx; right:20rpx; bottom:calc(24rpx + env(safe-area-inset-bottom)); z-index:90; background:var(--panel); color:var(--ink); border:1rpx solid var(--line); box-shadow:0 8rpx 32rpx rgba(0,0,0,.15); border-radius:20rpx; padding:16rpx 20rpx; display:flex; justify-content:space-between; align-items:center; }
.mini-undo text { flex:1; min-width:0; padding-right:16rpx; font-size:25rpx; }
.mini-modal-mask { position:fixed; left:0; top:0; right:0; bottom:0; z-index:120; background:rgba(0,0,0,.4); display:flex; align-items:center; justify-content:center; padding:24rpx; }
.mini-modal { width:100%; max-height:80vh; overflow:auto; box-sizing:border-box; }
.mini-modal .input,.mini-modal .pv { margin:14rpx 0; }
