{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "U-Time",
  "version": "0.171.0",
  "identifier": "com.yile.letime",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "U-Time · 时间块与四象限",
        "width": 1360,
        "height": 860,
        "minWidth": 400,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "dragDropEnabled": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "shortDescription": "U-Time · 时间块与四象限",
    "longDescription": "U-Time：本地优先的时间管理平台，整合四象限、时间块、课程表与插件扩展，支持 Windows / Linux / Android。",
    "targets": [
      "nsis",
      "msi",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    },
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "customLanguageFiles": {
          "SimpChinese": "installer-zh-CN.nsh"
        },
        "startMenuFolder": "U-Time",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh"
      },
      "wix": {
        "language": [
          "zh-CN"
        ]
      }
    }
  }
}
