{
  "id": "web-collector",
  "name": "网页收集",
  "version": "1.9.0",
  "author": "U-Time内置",
  "icon": "bookmark",
  "faIcon": "bookmark",
  "description": "输入或拖入网址，自动识别网站名称与图标；支持多网址拖入、搜索、备注和应用内打开。卡片像抽屉一样从底边立起：点卡片任意位置直接打开网站，右上角「⋯」翻起详情层改名与备注、换图标、刷新或删除。",
  "permissions": [
    "ui",
    "storage",
    "notify",
    "http",
    "openUrl"
  ],
  "entry": "main.js",
  "order": 2,
  "platforms": {
    "windows": "full",
    "android": "full",
    "miniprogram": "native"
  }
}
