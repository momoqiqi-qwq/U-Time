{
  "id": "web-collector",
  "name": "网页收集",
  "version": "1.8.0",
  "author": "U-Time内置",
  "icon": "bookmark",
  "faIcon": "bookmark",
  "description": "输入或拖入网址，自动识别网站名称与图标；支持多网址拖入、搜索、备注和应用内打开。卡片像抽屉一样从底边翻起：正面只有图标和网站名，翻起来改名称与备注、换图标、刷新或删除，鼠标悬停即翻，触屏点卡片。",
  "permissions": [
    "ui",
    "storage",
    "notify",
    "http",
    "openUrl"
  ],
  "entry": "main.js",
  "order": 2,
  "platforms": {
    "windows": "full",
    "android": "full",
    "miniprogram": "native"
  }
}
