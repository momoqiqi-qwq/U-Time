{
  "id": "web-collector",
  "name": "网页收集",
  "version": "1.6.0",
  "author": "U-Time内置",
  "icon": "bookmark",
  "faIcon": "bookmark",
  "description": "输入或拖入网址，自动识别网站名称与图标；支持多网址拖入、搜索、备注和应用内打开。卡片的编辑、刷新和删除操作可展开收起，长标题与备注可在卡片内查看。",
  "permissions": [
    "ui",
    "storage",
    "notify",
    "http",
    "openUrl"
  ],
  "entry": "main.js",
  "order": 2,
  "platforms": {
    "windows": "full",
    "android": "full",
    "miniprogram": "native"
  }
}
